<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/colorBackground"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="CPU Control"
            android:textColor="@color/colorTextPrimary"
            android:textSize="22sp"
            android:textStyle="bold"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Cluster"
            android:textColor="@color/colorTextSecondary"
            android:textSize="13sp"
            android:textStyle="bold"/>

        <Spinner
            android:id="@+id/spinner_clusters"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"/>

        <TextView
            android:id="@+id/tv_cores"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_card"
            android:padding="16dp"
            android:text="Cores: -"
            android:textColor="@color/colorTextPrimary"/>

        <TextView
            android:id="@+id/tv_governor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_card"
            android:padding="16dp"
            android:text="Governor: -"
            android:textColor="@color/colorTextPrimary"/>

        <TextView
            android:id="@+id/tv_min_freq"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_card"
            android:padding="16dp"
            android:text="Min freq: -"
            android:textColor="@color/colorTextPrimary"/>

        <TextView
            android:id="@+id/tv_max_freq"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_card"
            android:padding="16dp"
            android:text="Max freq: -"
            android:textColor="@color/colorTextPrimary"/>

        <TextView
            android:id="@+id/tv_cur_freq"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_card"
            android:padding="16dp"
            android:text="Cur freq: -"
            android:textColor="@color/colorTextPrimary"/>

        <TextView
            android:id="@+id/tv_lock_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_card"
            android:padding="16dp"
            android:text=""
            android:textColor="@color/colorError"
            android:textSize="13sp"
            android:visibility="gone"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Governor"
            android:textColor="@color/colorTextSecondary"
            android:textSize="13sp"
            android:textStyle="bold"/>

        <Spinner
            android:id="@+id/spinner_governor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Minimum frequency"
            android:textColor="@color/colorTextSecondary"
            android:textSize="13sp"
            android:textStyle="bold"/>

        <Spinner
            android:id="@+id/spinner_min_freq"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Maximum frequency"
            android:textColor="@color/colorTextSecondary"
            android:textSize="13sp"
            android:textStyle="bold"/>

        <Spinner
            android:id="@+id/spinner_max_freq"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"/>

        <Button
            android:id="@+id/btn_apply"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Apply" />

        <Button
            android:id="@+id/btn_reset"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Reset to hardware limits" />

        <TextView
            android:id="@+id/tv_rate_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Governor ramp limits (µs)"
            android:textColor="@color/colorTextSecondary"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone"/>

        <LinearLayout
            android:id="@+id/ll_rate_limits"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:orientation="horizontal"
            android:visibility="gone">

            <EditText
                android:id="@+id/et_up_rate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="ramp-up"
                android:importantForAutofill="no"
                android:inputType="number"
                android:textColor="@color/colorTextPrimary"
                android:textColorHint="@color/colorTextSecondary"/>

            <EditText
                android:id="@+id/et_down_rate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:hint="ramp-down"
                android:importantForAutofill="no"
                android:inputType="number"
                android:textColor="@color/colorTextPrimary"
                android:textColorHint="@color/colorTextSecondary"/>

        </LinearLayout>

        <Button
            android:id="@+id/btn_apply_rate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp"
            android:text="Apply ramp limits"
            android:visibility="gone" />

    </LinearLayout>
</ScrollView>
